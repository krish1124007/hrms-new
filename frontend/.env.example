# Backend API base URL.
# Local dev:    http://localhost:4000/api/v1
# Production:   https://your-backend-host.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Support e-mail shown on /support (the same address as the backend's SUPPORT_EMAIL).
# VITE_SUPPORT_EMAIL=support@example.com

# Optional — Sentry error reporting. Off unless set, and only for users who
# accept analytics cookies.
# VITE_SENTRY_DSN=

# Optional — Socket.io server origin (live field map). Defaults to the origin
# of VITE_API_URL. The map falls back to polling every 30 s when it cannot connect.
# VITE_SOCKET_URL=http://localhost:4000

# Optional — map tiles (Leaflet URL template). Defaults to OpenStreetMap; point
# it at an internal tile cache where openstreetmap.org is blocked.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Optional — address search ("find on map") for geofences and client locations:
# a Nominatim-compatible search URL. Empty (default) hides address search, so
# nothing is sent to a third-party geocoder.
# VITE_GEOCODE_URL=https://nominatim.openstreetmap.org/search
