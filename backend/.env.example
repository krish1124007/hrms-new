NODE_ENV=development
PORT=4000

# MongoDB — local Mongo, or a connection string from MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/hrms

# Redis — local Redis, or a managed Redis URL
REDIS_URL=redis://localhost:6379

# JWT — generate with:  openssl rand -hex 64
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_min_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# File uploads (payslips, attachments) — local disk path. Never served
# publicly: the API returns short-lived signed links to /api/v1/files/<key>.
UPLOAD_DIR=./uploads
# Origin those signed links are built on (production example below). Unset:
# CORS_ORIGIN in production, http://localhost:$PORT in development.
# PUBLIC_BASE_URL=https://hrms.ddipl.org
# How long a signed file link stays valid, in seconds.
FILE_URL_TTL_SECONDS=600

# Database backup tarballs — must be OUTSIDE UPLOAD_DIR. Never served as file
# links; downloaded only via GET /api/v1/backups/:id/download (backups.manage).
# Upgrading from backups in uploads/backups/? Run once: npm run backups:relocate
BACKUP_DIR=./backups
# The only database "Restore" may write into: a throwaway scratch database,
# never prod. It must name a database other than MONGODB_URI's. Unset (the
# default) disables restore: the API answers 400 RESTORE_TARGET_NOT_CONFIGURED.
# BACKUP_SCRATCH_MONGO_URI=mongodb://localhost:27017/hrms_restore_scratch

# Meilisearch — optional (search feature)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# SMTP — optional (password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Company branding (shown on payslips, invoices)
COMPANY_NAME=My Company
COMPANY_EMAIL=hr@example.com

# CORS — origin of the frontend (its public URL in production)
CORS_ORIGIN=http://localhost:5173

# ─── First admin (used only by: npm run seed:admin) ───
# No default credentials exist. Fill these in, run `npm run seed:admin` once,
# then clear ADMIN_PASSWORD from this file. Re-running never changes the
# password of an existing user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

LOG_LEVEL=info
