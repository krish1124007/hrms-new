NODE_ENV=development
PORT=4000
# Interface the API binds to (honoured by the HTTP server; default 0.0.0.0).
# HOST=127.0.0.1 is recommended behind nginx on the same host: the API then
# listens on loopback only and is reachable solely through the proxy.
# HOST=127.0.0.1

# MongoDB — local Mongo, or a connection string from MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/hrms

# Redis — local Redis, or a managed Redis URL
REDIS_URL=redis://localhost:6379

# JWT — generate with:  openssl rand -hex 64
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_min_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# File uploads (payslips, attachments) — local disk path. Never served
# publicly: the API returns short-lived signed links to /api/v1/files/<key>.
UPLOAD_DIR=./uploads
# Public origin of the web app. Signed file links are built on it, and so are
# the links in e-mails (accept invitation, reset password). Unset: signed file
# links fall back to CORS_ORIGIN in production and http://localhost:$PORT in
# development; e-mailed links fall back to CORS_ORIGIN.
# PUBLIC_BASE_URL=https://hrms.ddipl.org
# How long a signed file link stays valid, in seconds.
FILE_URL_TTL_SECONDS=600

# Database backup tarballs — must be OUTSIDE UPLOAD_DIR. Never served as file
# links; downloaded only via GET /api/v1/backups/:id/download (backups.manage).
# Upgrading from backups in uploads/backups/? Run once: npm run backups:relocate
BACKUP_DIR=./backups
# The only database "Restore" may write into: a throwaway scratch database,
# never prod. It must name a database other than MONGODB_URI's. Unset (the
# default) disables restore: the API answers 400 RESTORE_TARGET_NOT_CONFIGURED.
# BACKUP_SCRATCH_MONGO_URI=mongodb://localhost:27017/hrms_restore_scratch

# Meilisearch — optional (search feature)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# Mail — invitations, account activation and password-reset links are only
# delivered by e-mail. Configure ONE transport: RESEND_API_KEY (Resend HTTP
# API, used first when set) or SMTP_HOST (+ port/credentials). Outside
# production an unconfigured transport just logs the mail; in production the
# API refuses to start without one unless ALLOW_NO_MAIL=true.
# RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
# "true" lets a production API boot with no mail transport (e-mail disabled:
# nobody can receive an invitation or a reset link). Leave "false" normally.
ALLOW_NO_MAIL=false

# Push notifications (Firebase Cloud Messaging) — optional. Path to the
# Firebase service-account JSON (Firebase console → Project settings → Service
# accounts → Generate new private key). Keep the file outside the repo and
# readable only by the API user. When set, every in-app notification is also
# pushed to the user's registered phones; unset = no push.
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/dhrms/firebase-service-account.json

# Company branding (shown on payslips, invoices)
COMPANY_NAME=My Company
COMPANY_EMAIL=hr@example.com
# Tax identity printed on invoices. The defaults are placeholders — set your own.
COMPANY_GSTIN=27AAAAA0000A1Z5
# Also the Professional Tax state of an employee with no state on file (payroll);
# an employee whose address names another state pays that state's tax.
COMPANY_STATE_CODE=MH
GST_RATE_PERCENT=18

# Business timezone: the calendar day attendance, leave and payroll count in
# (lib/business-day.ts). Also set TZ=Asia/Kolkata in the pm2 environment.
TIMEZONE=Asia/Kolkata

# Statutory (payroll) — the values below are the defaults. PF is a percentage of
# the EARNED basic + DA, up to the wage ceiling. ESI applies while the full-month
# gross is within its ceiling; eligibility is decided once per Apr–Sep / Oct–Mar
# contribution period and kept for the rest of it.
PF_WAGE_CEILING=15000
PF_RATE_PERCENT=12
ESI_WAGE_CEILING=21000
ESI_EMPLOYEE_PERCENT=0.75
ESI_EMPLOYER_PERCENT=3.25

# CORS — origin of the frontend (its public URL in production)
CORS_ORIGIN=http://localhost:5173

# ─── First admin (used only by: npm run seed:admin) ───
# No default credentials exist. Fill these in, run `npm run seed:admin` once,
# then clear ADMIN_PASSWORD from this file. Re-running never changes the
# password of an existing user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

LOG_LEVEL=info

# API documentation — Swagger UI (/api/docs) and the OpenAPI JSON
# (/api/docs.json). Always served outside production; in production they are
# off unless this is "true".
ENABLE_API_DOCS=false
# Prometheus scrape endpoint (/api/metrics). Loopback callers need nothing;
# any other caller must send this value as the X-Metrics-Token header.
# Unset = only loopback may scrape. Generate with:  openssl rand -hex 32
# METRICS_TOKEN=
